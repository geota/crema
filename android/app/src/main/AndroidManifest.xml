<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ (API 31+) BLE runtime permissions. -->
    <!-- BLUETOOTH_SCAN: discover the DE1. usesPermissionFlags="neverForLocation"
         declares the scan is not used to derive physical location, so the
         ACCESS_FINE_LOCATION grant is not also required on API 31+. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- BLUETOOTH_CONNECT: connect to and exchange data with the DE1. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Keep the DE1 link (and its auto-reconnect) alive while the screen is
         off, via a connectedDevice foreground service (geota/crema#65). Only
         engaged while charging + the user opts in, so a battery device is
         unaffected. FOREGROUND_SERVICE_CONNECTED_DEVICE is the API 34+ typed
         permission the connectedDevice service type requires. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <!-- WAKE_LOCK: De1ConnectionService holds a partial wake lock while engaged.
         Normal permission (auto-granted); without the declaration acquire()
         throws SecurityException and crashes the app (geota/crema#72). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Network: Visualizer + Decent shot sync, the on-demand update check,
         Google Drive backup, and the multi-device LAN proxy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Guided-brew cue vibration (issue #10): a normal permission, no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Companion-device presence (optional, user-approved per device): the
         system watches for an associated DE1 / scale and binds
         CremaCompanionService when it comes into range, so Crema reconnects
         without scanning. OBSERVE_..._PRESENCE is required for
         startObservingDevicePresence; START_FOREGROUND_SERVICES_FROM_BACKGROUND
         lets the keep-alive service start on a presence event (the platform's
         documented CDM exemption from the Android 12 background-FGS-start
         ban; preferred over the broader RUN_IN_BACKGROUND). All are normal
         permissions and only take effect for an associated device. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <!-- Not required: without the feature the companion option is hidden. -->
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- Require BLE hardware. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- networkSecurityConfig: cleartext is allowed ONLY so a secondary can
         dial the primary's LAN relay (ws://<lan-ip>:<port>); a domain-config
         can't name "any LAN IP". The REST clients refuse non-https URLs
         themselves (net/HttpClients.kt). See res/xml/network_security_config.xml. -->
    <application
        android:name=".CremaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crema">

        <!-- singleTask: the Visualizer OAuth redirect re-enters the existing
             task via onNewIntent instead of stacking a second instance. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Crema">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Visualizer OAuth callback: crema://visualizer/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="crema" android:host="visualizer" />
            </intent-filter>
            <!-- Google Drive OAuth callback: <reversed-client-id>:/oauth2redirect.
                 The scheme is the build's googleRedirectScheme placeholder (derived
                 from the resolved Drive client_id in build.gradle.kts). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${googleRedirectScheme}" />
            </intent-filter>
        </activity>

        <!-- Sleep-on-quit: a do-nothing started service whose sole job is
             receiving onTaskRemoved when the user swipes Crema out of recents
             — the only signal the platform offers for "quit" (backgrounding
             delivers onStop; a swipe delivers nothing to activities). The
             handler puts an idle DE1 to sleep before the process goes. -->
        <service
            android:name=".ui.QuitSleepService"
            android:exported="false" />

        <!-- Keeps the process (and thus the DE1 BLE link + reconnect loop) alive
             while the screen is off (geota/crema#65). connectedDevice type: the
             app holds an active BLE connection to the DE1. Started only from the
             foreground, only while charging + opted in; stopped otherwise. -->
        <service
            android:name=".ble.De1ConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Companion-device presence callbacks (see the permissions above).
             Bound only by the system (BIND_COMPANION_DEVICE_SERVICE). -->
        <service
            android:name=".ble.companion.CremaCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>

        <!-- FileProvider — hands the camera app (TakePicture) a writable content
             Uri for the bean-photo capture temp file. Authority tracks the build's
             applicationId so it matches BuildConfig.APPLICATION_ID + ".fileprovider"
             in code. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
