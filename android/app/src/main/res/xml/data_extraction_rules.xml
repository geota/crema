<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules (Android 12+).

  `android:allowBackup="false"` already turns off cloud backup, but on some
  manufacturers' devices it does NOT stop device-to-device transfer for apps
  targeting API 31+, and adb backup on debuggable builds copies filesDir
  wholesale. The three files below hold credentials — the Visualizer OAuth
  tokens, the Decent account token, the Google Drive token — which must never
  leave this device: Decent cannot revoke its token per device, and a copied
  file would be a live session. Everything else (shots, beans, profiles,
  prefs) is the user's data and stays transferable; the in-app backup
  (Settings → Sharing → Back up) deliberately excludes these files too.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="visualizer.json" />
        <exclude domain="file" path="decent.json" />
        <exclude domain="file" path="drive.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="visualizer.json" />
        <exclude domain="file" path="decent.json" />
        <exclude domain="file" path="drive.json" />
    </device-transfer>
</data-extraction-rules>
