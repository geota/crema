{"title":"7g basket","notes":"This profile is optimized for the 7g Decent Basket.  You should weigh 7g of beans and dose them into the center mini-basket at the bottom.  You'll need a small 36mm tamper.  The flow rate is slowed down to prevent disturbing the puck.  A lower pressure is used to compensate for the lower puck integrity.  Final shot weight should be 18 to 28 grams.","type":"advanced","version":"2","author":"Decent","beverage_type":"espresso","tank_temperature":0,"steps":[{"name":"preinfusion temp boost","temperature":90,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":2.4,"seconds":2,"volume":0,"weight":null,"exit":{"type":"pressure","condition":"over","value":4.5}},{"name":"preinfusion","temperature":90,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":2.4,"seconds":6,"volume":0,"weight":null,"exit":{"type":"pressure","condition":"over","value":4.5}},{"name":"forced rise","temperature":90,"sensor":"coffee","pump":"pressure","transition":"fast","pressure":7.5,"flow":0,"seconds":3,"volume":0,"weight":null,"limiter":{"value":6,"range":1}},{"name":"rise and hold","temperature":90,"sensor":"coffee","pump":"pressure","transition":"fast","pressure":7.5,"flow":0,"seconds":3,"volume":0,"weight":null,"limiter":{"value":6,"range":1}},{"name":"decline","temperature":90,"sensor":"coffee","pump":"pressure","transition":"smooth","pressure":4.5,"flow":0,"seconds":10,"volume":0,"weight":null,"limiter":{"value":6,"range":1}}],"target_weight":35,"target_volume":36,"target_volume_count_start":3,"grinder_dose_weight":18}
{"title":"Blooming Allongé","notes":"An amazing long espresso for light roasts, this is a fruit bomb of a brewing method. 5:1 ratio, 60 seconds, very fine grind. If close to the right pressure, make 0.5g dose adjustments to get to an 8-9 bar peak. The very high flow rate means small grind adjustments cause big pressure changes. A very advanced technique, extractions average 26%.","type":"advanced","version":"2","author":"Decent","beverage_type":"espresso","tank_temperature":0,"steps":[{"name":"fast pre start","temperature":95,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":4.5,"seconds":2,"volume":500,"weight":null},{"name":"fast pre","temperature":95,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":4.5,"seconds":3,"volume":500,"weight":null,"exit":{"type":"pressure","condition":"over","value":3.5}},{"name":"ramp down pre","temperature":93,"sensor":"coffee","pump":"flow","transition":"smooth","pressure":0,"flow":2,"seconds":15,"volume":500,"weight":null,"exit":{"type":"pressure","condition":"over","value":3.5}},{"name":"bloom","temperature":93,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":0,"seconds":30,"volume":500,"weight":null},{"name":"ramp","temperature":92.5,"sensor":"coffee","pump":"flow","transition":"smooth","pressure":0,"flow":3.5,"seconds":7,"volume":500,"weight":null},{"name":"hold at 3.5 ml/s","temperature":91,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":3.5,"seconds":60,"volume":500,"weight":null,"limiter":{"value":8.6,"range":0.6}}],"target_weight":135,"target_volume":180,"target_volume_count_start":0,"grinder_dose_weight":18}
{"title":"A-Flow / default-dark","notes":"A-Flow: an alternative profile for D-Flow","type":"advanced","version":"2","author":"Decent","beverage_type":"espresso","tank_temperature":0,"steps":[{"name":"Fill","temperature":93,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":8,"seconds":15,"volume":100,"weight":null,"exit":{"type":"pressure","condition":"over","value":3},"limiter":{"value":8,"range":0.6}},{"name":"Infuse","temperature":93,"sensor":"coffee","pump":"pressure","transition":"fast","pressure":3,"flow":0,"seconds":10,"volume":100,"weight":2,"limiter":{"value":1,"range":0.6}},{"name":"Pressure Up","temperature":88,"sensor":"coffee","pump":"pressure","transition":"smooth","pressure":9,"flow":0,"seconds":5,"volume":100,"weight":null,"exit":{"type":"flow","condition":"over","value":2}},{"name":"Pressure Decline","temperature":88,"sensor":"coffee","pump":"pressure","transition":"smooth","pressure":1,"flow":0,"seconds":0,"volume":100,"weight":null,"exit":{"type":"flow","condition":"under","value":2.1}},{"name":"Flow Start","temperature":88,"sensor":"coffee","pump":"flow","transition":"fast","pressure":0,"flow":2,"seconds":0,"volume":100,"weight":null},{"name":"Flow Extraction","temperature":88,"sensor":"coffee","pump":"flow","transition":"smooth","pressure":0,"flow":0,"seconds":60,"volume":100,"weight":null,"limiter":{"value":9,"range":0.6}}],"target_weight":36,"target_volume":100,"target_volume_count_start":2,"grinder_dose_weight":18}