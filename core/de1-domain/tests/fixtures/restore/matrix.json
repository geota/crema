{
  "about": "One case per row: a store, a mode, what's here (a LocalState), what the backup holds, and what the plan must say, as JSON pointers into the RestorePlan. The backup's rows are built from the backup fixtures' rows with these ids. Run against plan_restore in Rust (tests/backup_plan.rs); the shells run the same cases against their real stores (restore-safety PR7).",
  "cases": [
    {
      "name": "beans: merge adds what's missing and keeps what's here",
      "store": "beans",
      "mode": "merge",
      "local": {
        "beans": [
          "b1"
        ]
      },
      "backup": {
        "beans": [
          "b1",
          "b2"
        ]
      },
      "expect": {
        "/beans/add": [
          "b2"
        ],
        "/beans/keep": 1,
        "/beans/overwrite": [],
        "/beans/remove": [],
        "/verdict": "ok"
      }
    },
    {
      "name": "beans: merge never removes a bean only here",
      "store": "beans",
      "mode": "merge",
      "local": {
        "beans": [
          "b1",
          "b3"
        ]
      },
      "backup": {
        "beans": [
          "b1"
        ]
      },
      "expect": {
        "/beans/remove": [],
        "/beans/keep": 1
      }
    },
    {
      "name": "beans: replace matches the backup",
      "store": "beans",
      "mode": "replace",
      "local": {
        "beans": [
          "b1",
          "b3"
        ]
      },
      "backup": {
        "beans": [
          "b1",
          "b2"
        ]
      },
      "expect": {
        "/beans/add": [
          "b2"
        ],
        "/beans/overwrite": [
          "b1"
        ],
        "/beans/remove": [
          "b3"
        ],
        "/verdict": "confirm"
      }
    },
    {
      "name": "roasters: replace with no roasters in an old header keeps them",
      "store": "roasters",
      "mode": "replace",
      "local": {
        "roasters": [
          "r1"
        ],
        "beans": [
          "b1"
        ]
      },
      "backup": {
        "beans": [
          "b1"
        ],
        "omitCounts": [
          "roasterCount"
        ]
      },
      "expect": {
        "/roasters/remove": [],
        "/roasters/keep": 1
      }
    },
    {
      "name": "roasters: replace with zero roasters counted removes them",
      "store": "roasters",
      "mode": "replace",
      "local": {
