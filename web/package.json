{
  "name": "crema-web",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.0.5",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "wasm": "wasm-pack build ../core/de1-wasm --target web --out-dir ../../web/src/lib/wasm --out-name de1_wasm",
    "wasm:test": "wasm-pack build ../core/de1-wasm --target web --out-dir ../../web/.wasm-test --out-name de1_wasm -- --features test-seeds,dev-oracle",
    "wasm:history": "../scripts/history-wasm-build.sh",
    "wasm:history:test": "../scripts/history-wasm-build.sh --test",
    "dev": "vite dev",
    "build": "pnpm wasm && pnpm wasm:history && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''; git config core.hooksPath .githooks 2>/dev/null || true",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "test:browser": "tsc -p tests/browser && playwright test",
    "test:pwa": "tsc -p tests/browser && playwright test -c playwright.pwa.config.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "openapi": "openapi-typescript src/lib/visualizer/openapi.json -o src/lib/visualizer/openapi.d.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/web-bluetooth": "^0.0.22",
    "@vite-pwa/sveltekit": "2.0.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "^31.0.0",
    "magicast": "^0.5.5",
    "openapi-typescript": "^7.13.0",
    "subset-font": "^2.9.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@beacio/core": "2.2.0",
    "bits-ui": "^2.20.6",
    "effect": "^4.1.2",
    "fflate": "^0.8.3",
    "phosphor-svelte": "^3.1.1",
    "uplot": "^1.6.32"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
