{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// `$app/tsconfig` (SvelteKit 3) supplies the module settings, the
		// `#lib` subpath imports and `allowImportingTsExtensions` (the
		// `node:test` files import siblings with explicit `.ts`, as Node's
		// `--experimental-strip-types` resolver requires).
		// The Web Bluetooth API is not in TypeScript's standard DOM lib;
		// `@types/web-bluetooth` supplies `navigator.bluetooth` and the
		// `Bluetooth*` GATT types the `#lib/ble` layer depends on.
		"types": [
			"$app/types",
			"@types/web-bluetooth"
		]
	},
	// The three globs, not a bare "src": a directory include also pulls the
	// wasm-pack glue (src/lib/wasm/de1_wasm.js) into checkJs and yields ~800
	// implicit-any errors; with globs TypeScript prefers its sibling .d.ts.
	"include": [
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"vite.config.ts"
	]
}
