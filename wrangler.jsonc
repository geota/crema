{
  // Cloudflare Pages config for the Crema static PWA — the only wrangler
  // config. The Pages project is Direct Upload (no Git connection): the
  // release workflow builds web/build on a version tag and runs
  // `wrangler pages deploy web/build --project-name crema --branch main`
  // from the repo root, which reads this file. The same command from a
  // local shell does a manual hotfix deploy (see DEPLOY.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crema",
  "pages_build_output_dir": "web/build",
  "compatibility_date": "2025-05-01"
}
